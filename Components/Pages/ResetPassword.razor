@page "/Account/ResetPassword"
@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation
<PageTitle>Reset password</PageTitle>
<div class="auth-shell"><div class="auth-card"><p class="auth-kicker">ACCOUNT RECOVERY</p><h1>Set a new password</h1><p class="auth-subtitle">Choose a new password for your account.</p><form method="post" action="/api/auth/reset-form"><AntiforgeryToken /><input type="hidden" name="token" value="@Token" /><div class="form-floating mb-3"><input class="form-control" name="password" type="password" minlength="12" placeholder="New password" required /><label>New password</label></div><button class="btn btn-primary w-100">Reset password</button></form></div></div>
@code { [SupplyParameterFromQuery] private string Token { get; set; } = ""; }
