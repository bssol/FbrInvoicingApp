@page "/Account/ForgotPassword"
<PageTitle>Forgot password</PageTitle>
@if (Sent) { <div class="alert alert-info">If an active account matches this email, reset instructions will be sent. Contact your administrator if the email does not arrive.</div> }
@if (Error is not null) { <div class="alert alert-danger">@Error</div> }
@code { [SupplyParameterFromQuery(Name = "sent")] public bool Sent { get; set; } [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; } }
<div class="auth-shell"><div class="auth-card"><p class="auth-kicker">ACCOUNT RECOVERY</p><h1>Forgot your password?</h1><p class="auth-subtitle">Enter your account email to receive reset instructions.</p><form method="post" action="/api/auth/forgot-form"><AntiforgeryToken /><div class="form-floating mb-3"><input class="form-control" name="email" type="email" placeholder="name@example.com" required /><label>Email</label></div><button class="btn btn-primary w-100">Request reset link</button></form><div class="auth-links"><a href="/Account/Login">Return to sign in</a></div></div></div>
