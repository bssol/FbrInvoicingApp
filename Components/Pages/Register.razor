@page "/Account/Register"

<PageTitle>Create account</PageTitle>

@if (Error is not null)
{
	<div class="alert alert-danger">@Error</div>
}

@code
{
	[SupplyParameterFromQuery(Name = "error")]
	public string? Error { get; set; }
}

<div class="auth-shell">
	<div class="auth-card">
		<p class="auth-kicker">GET STARTED</p>
		<h1>Create your account</h1>
		<p class="auth-subtitle">Set up your secure FBR Invoice Desk access.</p>
		<form method="post" action="/api/auth/register-form">
			<AntiforgeryToken />
			<div class="form-floating mb-3">
				<input class="form-control" name="Email" type="email" placeholder="name@example.com" required />
				<label>Email</label>
			</div>
			<div class="form-floating mb-3">
				<input class="form-control" name="Password" type="password" minlength="12" placeholder="Password" required />
				<label>Password</label>
			</div>
			<button class="btn btn-primary btn-lg w-100">Create account</button>
		</form>

		<div class="auth-links">
			<a href="/Account/Login">Back to sign in</a>
		</div>

	</div>

</div>
